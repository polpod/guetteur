# Copiez ce fichier en .env et renseignez les valeurs. Ne commitez jamais .env.

# Clé API Anthropic : UNIQUEMENT avec [summarize] provider = "claude_api".
# Avec provider = "claude_code" (défaut), laissez vide : la session Claude Code est utilisée.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram : jeton donné par @BotFather, et identifiant du chat destinataire
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_CHAT_ID=123456789

# WhatsApp Cloud API (Meta) : jeton d'accès, ID du numéro expéditeur, numéro destinataire
# (format international sans « + » ni espaces, ex. 33612345678)
WA_TOKEN=EAAG...
WA_PHONE_ID=123456789012345
WA_TO=33612345678

# YouTube Data API v3 : clé API pour les playlists publiques et non répertoriées.
# Sans elle (défaut), GUETTEUR lit le flux RSS (latence jusqu'à 1 h) ; avec elle,
# l'API playlistItems.list est utilisée et la détection tombe sous les 60 s.
# Créer une clé dans console.cloud.google.com → APIs & Services → Credentials, en
# activant « YouTube Data API v3 ». Restreindre à l'API et à l'IP du LXC pour éviter
# une fuite. Quota : 10 000 unités/jour (1 par appel playlistItems.list).
YOUTUBE_API_KEY=
