# /etc/systemd/system/guetteur.service — installé par scripts/install-lxc.sh
[Unit]
Description=GUETTEUR - veille YouTube résumée par Claude
Documentation=file:///opt/guetteur/README.md
Wants=network-online.target guetteur-health.timer
After=network-online.target
# Pas de démarrage tant que .env n'est pas en place (install-lxc.sh laisse l'unité désactivée).
ConditionPathExists=/opt/guetteur/.env

[Service]
Type=simple
User=guetteur
Group=guetteur
WorkingDirectory=/opt/guetteur
EnvironmentFile=/opt/guetteur/.env
# uv (/usr/local/bin) et claude (/usr/bin, installé par npm -g) doivent être dans le PATH.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Le binaire claude est installé en root : pas de mise à jour automatique par le service.
Environment=DISABLE_AUTOUPDATER=1
# --no-sync : l'environnement est préparé par install-lxc.sh (uv sync --frozen --no-dev).
ExecStart=/usr/local/bin/uv run --no-sync guetteur run
Restart=always
RestartSec=10
TimeoutStopSec=30

# Durcissement (lot déploiement). ProtectHome=yes masque les /home/* ; le service
# a besoin de son propre HOME (/home/guetteur pour la session Claude Code stockée
# dans ~/.claude/) → on liste /home/guetteur en ReadWritePaths. /opt/guetteur/data
# (base SQLite, vault Obsidian, NotebookLM home) doit rester inscriptible.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/guetteur/data /home/guetteur
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
# git (SSH pour le vault), claude, yt-dlp et ffmpeg n'ont besoin que d'IP + local sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Aucune capability nécessaire (le service ne fait ni bind privilégié, ni ptrace).
CapabilityBoundingSet=
AmbientCapabilities=
# Whitelist des appels système utiles à un service Python + subprocess.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
