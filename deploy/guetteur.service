# /etc/systemd/system/guetteur.service — installé par scripts/install-lxc.sh
[Unit]
Description=GUETTEUR - veille YouTube résumée par Claude
Documentation=file:///opt/guetteur/README.md
Wants=network-online.target guetteur-health.timer
After=network-online.target
# Pas de démarrage tant que .env n'est pas en place (install-lxc.sh laisse l'unité désactivée).
ConditionPathExists=/opt/guetteur/.env

[Service]
Type=simple
User=guetteur
Group=guetteur
WorkingDirectory=/opt/guetteur
EnvironmentFile=/opt/guetteur/.env
# uv (/usr/local/bin) et claude (/usr/bin, installé par npm -g) doivent être dans le PATH.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Locale UTF-8 générée par install-lxc.sh : évite les warnings perl/python en LXC.
Environment=LANG=fr_FR.UTF-8
Environment=LC_ALL=fr_FR.UTF-8
# ProtectHome=read-only cache /home aux autres users mais laisse la lecture au service.
# uv cherche son cache dans $XDG_CACHE_HOME → forcer un chemin inscriptible sous data/.
Environment=UV_CACHE_DIR=/opt/guetteur/data/.uv-cache
# Le binaire claude est installé en root : pas de mise à jour automatique par le service.
Environment=DISABLE_AUTOUPDATER=1
# --no-sync : l'environnement est préparé par install-lxc.sh (uv sync --frozen --no-dev).
ExecStart=/usr/local/bin/uv run --no-sync guetteur run
Restart=always
RestartSec=10
TimeoutStopSec=30

# Durcissement (post-déploiement). ProtectHome=read-only : le service lit ~/.claude
# (session Claude Code, mise à jour par le binaire) et ~/.cache (uv, playwright, etc.)
# mais ne peut pas fouiller les autres /home. ReadWritePaths énumère les seuls chemins
# où l'écriture est autorisée. /opt/guetteur/data porte la base SQLite, le vault, le
# home NotebookLM et le cache uv (UV_CACHE_DIR ci-dessus).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/guetteur/data /home/guetteur/.claude /home/guetteur/.claude.json /home/guetteur/.cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
# git (SSH pour le vault), claude, yt-dlp et ffmpeg n'ont besoin que d'IP + local sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Aucune capability nécessaire (le service ne fait ni bind privilégié, ni ptrace).
CapabilityBoundingSet=
AmbientCapabilities=
# Whitelist des appels système utiles à un service Python + subprocess.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
