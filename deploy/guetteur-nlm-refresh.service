# /etc/systemd/system/guetteur-nlm-refresh.service — refresh Google/NotebookLM
# Lancé toutes les 6 h par guetteur-nlm-refresh.timer sous l'utilisateur guetteur.
# Utilise le binaire `notebooklm` installé par uv tool sous l'utilisateur guetteur
# (/home/guetteur/.local/bin/notebooklm) — /usr/local/bin/notebooklm est un symlink.
# Les cookies vivent dans NOTEBOOKLM_HOME (dossier dédié, 0700, jamais ~).
[Unit]
Description=GUETTEUR - refresh cookies NotebookLM (toutes les 6 h)
ConditionPathIsDirectory=/opt/guetteur/data/nlm
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=guetteur
Group=guetteur
WorkingDirectory=/opt/guetteur
Environment=NOTEBOOKLM_HOME=/opt/guetteur/data/nlm
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=LANG=fr_FR.UTF-8
Environment=LC_ALL=fr_FR.UTF-8
# Le binaire notebooklm (uv tool) peut écrire un lock/cache : on lui donne le même
# UV_CACHE_DIR que le service principal, sous /opt/guetteur/data.
Environment=UV_CACHE_DIR=/opt/guetteur/data/.uv-cache
# --quiet limite la sortie ; le service échoue silencieusement si les cookies sont
# perdus (l'admin doit alors refaire un login WSL et pousser le master token).
ExecStart=/usr/local/bin/notebooklm auth refresh --quiet
# Durcissement : mêmes chemins d'écriture que guetteur.service, cohérence entre unités.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/guetteur/data /home/guetteur/.claude /home/guetteur/.claude.json /home/guetteur/.cache
ProtectKernelTunables=true
ProtectControlGroups=true
