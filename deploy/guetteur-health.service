# /etc/systemd/system/guetteur-health.service — lancé par guetteur-health.timer
[Unit]
Description=GUETTEUR - healthcheck (alerte Telegram si KO, au plus une par heure)
ConditionPathExists=/opt/guetteur/.env

[Service]
Type=oneshot
User=guetteur
Group=guetteur
WorkingDirectory=/opt/guetteur
EnvironmentFile=/opt/guetteur/.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=LANG=fr_FR.UTF-8
Environment=LC_ALL=fr_FR.UTF-8
# uv veut écrire son cache : sous ProtectHome=read-only, /home/guetteur/.cache
# n'est pas suffisant si uv fait un lock sous ~/.local/share, on lui donne un
# répertoire dédié dans data/.
Environment=UV_CACHE_DIR=/opt/guetteur/data/.uv-cache
# Code retour 1 si KO : l'unité apparaît en échec dans systemctl, et l'alerte part.
ExecStart=/usr/local/bin/uv run --no-sync guetteur health --alert
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/guetteur/data /home/guetteur/.claude /home/guetteur/.claude.json /home/guetteur/.cache
